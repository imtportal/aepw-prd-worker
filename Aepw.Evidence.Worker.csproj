
name: Build and Deploy Azure Function

on:
  push:
    branches:
      - main

  workflow_dispatch:

env:
  AZURE_FUNCTIONAPP_NAME: 'aepw-worker'
  DOTNET_VERSION: '10.0.x'
  PROJECT_FILE: 'Aepw.Evidence.Worker.csproj'
  PUBLISH_DIR: './publish'

jobs:
  build-and-deploy:
    runs-on: ubuntu-latest

    steps:
      - name: Checkout code
        uses: actions/checkout@v4

      - name: Setup .NET
        uses: actions/setup-dotnet@v4
        with:
          dotnet-version: ${{ env.DOTNET_VERSION }}

      - name: Restore dependencies
        run: dotnet restore ${{ env.PROJECT_FILE }}

      - name: Build
        run: |
          dotnet build ${{ env.PROJECT_FILE }} \
            --configuration Release \
            --no-restore

      - name: Publish Function App
        run: |
          rm -rf ${{ env.PUBLISH_DIR }}

          dotnet publish ${{ env.PROJECT_FILE }} \
            --configuration Release \
            --no-restore \
            --output ${{ env.PUBLISH_DIR }}

      - name: Verify Function package
        shell: bash
        run: |
          set -e

          echo "===== PUBLISH DIRECTORY ====="
          ls -lah ${{ env.PUBLISH_DIR }}

          echo "===== REQUIRED FILES ====="

          for file in \
            host.json \
            worker.config.json \
            extensions.json
          do
            if [ ! -s "${{ env.PUBLISH_DIR }}/$file" ]; then
              echo "ERROR: $file is missing or empty"
              exit 1
            fi

            echo "FOUND: $file"
          done

          echo "===== WORKER CONFIG VALIDATION ====="
          jq empty "${{ env.PUBLISH_DIR }}/worker.config.json"

          WORKER_INDEXING=$(jq -r '.description.workerIndexing' "${{ env.PUBLISH_DIR }}/worker.config.json")

          echo "workerIndexing: $WORKER_INDEXING"

          if [ "$WORKER_INDEXING" != "true" ]; then
            echo "ERROR: worker.config.json does not have workerIndexing=true"
            exit 1
          fi

          echo "===== METADATA LOADER VALIDATION ====="

          if [ ! -f "${{ env.PUBLISH_DIR }}/.azurefunctions/Microsoft.Azure.WebJobs.Extensions.FunctionMetadataLoader.dll" ]; then
            echo "ERROR: FunctionMetadataLoader.dll missing from .azurefunctions/"
            exit 1
          fi

          echo "FOUND: FunctionMetadataLoader.dll"

          echo "===== PACKAGE VALIDATION SUCCESSFUL ====="

      - name: Deploy to Azure Function
        uses: Azure/functions-action@v1
        with:
          app-name: ${{ env.AZURE_FUNCTIONAPP_NAME }}
          publish-profile: ${{ secrets.AZURE_FUNCTIONAPP_PUBLISH_PROFILE }}
          package: ${{ env.PUBLISH_DIR }}
